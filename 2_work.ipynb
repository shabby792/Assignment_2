import pandas as pd

# Load data
df = pd.read_csv("teaching_prices_messy.csv")

# Check original data
print("Original shape:", df.shape)
display(df.head())

# Clean item names
df["item"] = df["item"].str.strip().str.title()

# Convert prices to numbers
df["price"] = pd.to_numeric(
    df["price"].astype(str).str.replace(",", ""),
    errors="coerce"
)

# Remove exact duplicates
df = df.drop_duplicates()

# Check missing and unusual prices
print("Missing prices:", df["price"].isna().sum())
print("Prices above 1000:")
display(df[df["price"] > 1000])

# Show cleaned data
print("Cleaned shape:", df.shape)
display(df.head())

# Save cleaned data
df.to_csv("candidate_cleaned_prices.csv", index=False)
